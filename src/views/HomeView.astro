---
import Base from '../layouts/Base.astro';
import DialectCard from '../components/DialectCard.astro';
import { LANGS, homePath, pick, type Lang } from '../i18n/langs';
import { t } from '../i18n/ui';
import type { Dialect } from '../lib/schema';

interface Props {
  lang: Lang;
  dialects: Dialect[];
}
const { lang, dialects } = Astro.props;
const alternates = Object.fromEntries(LANGS.map((l) => [l, homePath(l)])) as Record<Lang, string>;
const live = dialects.filter((d) => d.status === 'live');
const soon = dialects.filter((d) => d.status === 'soon');
const showSample = live.some((d) => !d.reviewed);
---
<Base lang={lang} title={t(lang, 'metaHomeTitle')} description={t(lang, 'metaHomeDesc')} alternates={alternates} preloadFont>
  <section class="wrap hero">
    <h1 class="hero-title">{t(lang, 'heroTitle')}</h1>
  </section>

  <section class="wrap section" id="dialects">
    <div class="dialect-grid">
      {live.map((d) => <DialectCard lang={lang} dialect={d} />)}
    </div>
    {soon.length > 0 && (
      <p class="soon-line">{t(lang, 'comingSoonList')}{soon.map((d) => pick(lang, d.name, d.nameEn)).join(' · ')}</p>
    )}
    {showSample && <p class="sample-notice">{t(lang, 'sampleNotice')}</p>}
  </section>
</Base>
