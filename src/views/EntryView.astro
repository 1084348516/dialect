---
import Base from '../layouts/Base.astro';
import FeedbackForm from '../components/FeedbackForm.astro';
import { LANGS, homePath, dialectPath, entryPath, pick, glossLine, type Lang } from '../i18n/langs';
import { t } from '../i18n/ui';
import { toHant, toHans } from '../i18n/convert';
import { relatedEntries, neighbors } from '../lib/entries';
import type { Dialect } from '../lib/schema';

interface Props {
  lang: Lang;
  dialects: Dialect[];
  dialectId: string;
  entryId: string;
}
const { lang, dialects, dialectId, entryId } = Astro.props;
const d = dialects.find((x) => x.id === dialectId)!;
const e = d.entries.find((x) => x.id === entryId)!;
const cat = d.categories.find((c) => c.id === e.category)!;
const romanization = d.romanization!;

const alternates = Object.fromEntries(LANGS.map((l) => [l, entryPath(l, d.id, e.id)])) as Record<Lang, string>;
const name = pick(lang, d.name, d.nameEn);
const catName = pick(lang, cat.name, cat.nameEn);
const meaningZh = e.meaning ?? e.zh;
const meaningEn = e.meaningEn ?? e.en;
// 没有英文释义时只显示中文，英文页面也退回中文
const meaningMain = pick(lang, meaningZh, meaningEn ?? meaningZh);
const meaningSecondary = meaningEn && pick(lang, meaningEn, meaningZh);
const note = lang === 'en' ? (e.noteEn ?? e.note) : e.note;
const related = relatedEntries(d, e);
const { prev, next } = neighbors(d, e.id);

const gloss = pick(lang, e.zh, e.en ?? e.zh);
// 页面上的方言原文不转换，但繁体页的标题和摘要用繁体字形，方便匹配繁体搜索词；
// 粤语这类使用者主要写繁体的方言，英文页也用繁体
const hant = e.textHant ?? toHant(e.text);
const useHant = lang === 'zh-hant' || (lang === 'en' && d.traditional);
const metaText = lang === 'zh-hant' && hant !== e.text ? `${hant}（${e.text}）` : useHant ? hant : e.text;
const descText = useHant ? hant : e.text;
// 词条和普通话说法一样时（如“新年快乐”），问“是什么意思”不合适，改问“怎么说”；
// 英文页的粗口释义是“crude curse”这类描述，不能问 how to say，改成词条在前
const termFirst = lang === 'en' ? cat.caution : toHans(gloss).startsWith(toHans(e.text));
const title = `${t(lang, termFirst ? 'metaEntryTitleSame' : 'metaEntryTitle', { text: metaText, pron: e.pron, gloss, dialect: name })} | Familect`;
// 搜索结果摘要：先给方言、读音和意思，有详细释义再接在后面，没有就用使用提示补上。
// 英文页没有英文提示时不拿中文凑；常见拼法只放英文页，按拼法搜的基本是英文用户
const spellings = lang === 'en' && e.spellings.length > 0 ? t(lang, 'metaEntrySpellings', { spellings: e.spellings.join(', ') }) : '';
const extra = meaningMain !== gloss ? meaningMain : lang === 'en' ? e.noteEn : e.note;
const description = [t(lang, 'metaEntryDesc', { text: descText, pron: e.pron, gloss, dialect: name }), spellings, extra]
  .filter(Boolean)
  .join(lang === 'en' ? ' ' : '');
const abs = (p: string) => new URL(p, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    name: e.text,
    alternateName: [...new Set([e.pron, ...(hant !== e.text ? [hant] : []), ...e.alt, ...e.spellings])],
    description: meaningMain,
    url: abs(entryPath(lang, d.id, e.id)),
    inDefinedTermSet: { '@type': 'DefinedTermSet', name: t(lang, 'metaDialectTitle', { dialect: name }), url: abs(dialectPath(lang, d.id)) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(lang, 'home'), item: abs(homePath(lang)) },
      { '@type': 'ListItem', position: 2, name, item: abs(dialectPath(lang, d.id)) },
      { '@type': 'ListItem', position: 3, name: e.text, item: abs(entryPath(lang, d.id, e.id)) },
    ],
  },
];
---
<Base lang={lang} title={title} description={description} alternates={alternates} jsonLd={jsonLd} feedbackDialect={false}>
  <div class="wrap page">
    <nav class="breadcrumb">
      <a href={homePath(lang)}>{t(lang, 'home')}</a> /
      <a href={dialectPath(lang, d.id)}>{name}</a> /
      <a href={`${dialectPath(lang, d.id)}?cat=${cat.id}`}>{catName}</a> /
      <span>{e.text}</span>
    </nav>

    <div class="entry-layout">
      <article class="entry-main">
        <section class="card headword">
          <div class="headword-top">
            <h1 class="headword-text">{e.text}</h1>
            <span class="headword-meta">{name} · {catName}</span>
          </div>
          <div class="readings">
            <div class="reading"><span class="reading-label">{pick(lang, romanization.name, romanization.nameEn)}</span><span class="reading-value pron">{e.pron}</span></div>
            {e.homophone && <div class="reading"><span class="reading-label">{t(lang, 'homophone')}</span><span class="reading-value">{e.homophone}</span></div>}
            {e.enReading && <div class="reading"><span class="reading-label">{t(lang, 'enReading')}</span><span class="reading-value">{e.enReading}</span></div>}
            {e.spellings.length > 0 && <div class="reading"><span class="reading-label">{t(lang, 'spellings')}</span><span class="reading-value">{e.spellings.join(', ')}</span></div>}
          </div>
          <div class="headword-foot">
            <span class="audio-soon" aria-disabled="true" data-nosnippet>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.5 8.5a5 5 0 0 1 0 7" /></svg>
              {t(lang, 'audioSoon')}
            </span>
            {e.alt.length > 0 && <span>{t(lang, 'alsoWritten')}{e.alt.join('、')}</span>}
          </div>
        </section>

        <section class="entry-section">
          <h2>{t(lang, 'meaning')}</h2>
          <p>{meaningMain}</p>
          {meaningSecondary && <p class="meaning-secondary">{meaningSecondary}</p>}
          {e.literal && <p class="literal">{t(lang, 'literal')}{e.literal}</p>}
          {note && <p class="tip">{t(lang, 'usageTip')}{note}</p>}
        </section>

        {e.examples.length > 0 && (
          <section class="entry-section">
            <h2>{t(lang, 'examples')}</h2>
            {e.examples.map((x) => (
              <div class="card example">
                <p class="serif example-text">{x.text}</p>
                <p class="pron">{x.pron}</p>
                <p class="example-gloss">{glossLine(lang, x.zh, x.en)}</p>
              </div>
            ))}
          </section>
        )}

        {e.variants.length > 0 && (
          <section class="entry-section">
            <h2>{t(lang, 'variants')}</h2>
            <div class="card table-wrap">
              <table>
                <thead><tr><th>{t(lang, 'variantRegion')}</th><th>{t(lang, 'variantForm')}</th><th>{t(lang, 'variantNote')}</th></tr></thead>
                <tbody>
                  {e.variants.map((v) => (
                    <tr><td>{v.region}</td><td>{v.text ?? t(lang, 'toBeConfirmed')}</td><td>{v.note ?? ''}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <!-- 翻页、反馈表单这类界面文字不要出现在搜索结果摘要里 -->
        <div data-nosnippet>
          <nav class="entry-pager">
            {prev && <a rel="prev" href={entryPath(lang, d.id, prev.id)}>← {t(lang, 'prev')} · {prev.text}</a>}
            {next && <a rel="next" href={entryPath(lang, d.id, next.id)}>{t(lang, 'next')} · {next.text} →</a>}
          </nav>

          <FeedbackForm lang={lang} dialectId={d.id} entryId={e.id} />
        </div>
      </article>

      {related.length > 0 && (
        <aside class="entry-aside">
          <p class="aside-label">{t(lang, 'related')}</p>
          {related.map((r) => (
            <a class="card related" href={entryPath(lang, d.id, r.id)}>
              <span class="serif">{r.text}</span>
              <small>{pick(lang, r.zh, r.en ?? r.zh)}</small>
            </a>
          ))}
        </aside>
      )}
    </div>
  </div>
</Base>
