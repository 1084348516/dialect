---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import { LANGS, homePath, dialectPath, categoryPath, exportPath, pick, type Lang } from '../i18n/langs';
import { t } from '../i18n/ui';
import { isCaution, usedCategories } from '../lib/entries';
import type { Dialect } from '../lib/schema';

interface Props {
  lang: Lang;
  dialects: Dialect[];
  dialectId: string;
}
const { lang, dialects, dialectId } = Astro.props;
const d = dialects.find((x) => x.id === dialectId)!;
const alternates = Object.fromEntries(LANGS.map((l) => [l, dialectPath(l, d.id)])) as Record<Lang, string>;
const name = pick(lang, d.name, d.nameEn);
const otherName = pick(lang, d.nameEn, d.name);
const intro = pick(lang, d.intro, d.introEn) ?? '';
const withPage = new Set(usedCategories(d).map((c) => c.id));
const catName = (id: string) => {
  const c = d.categories.find((x) => x.id === id)!;
  return pick(lang, c.name, c.nameEn);
};
const abs = (p: string) => new URL(p, Astro.site).href;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'home'), item: abs(homePath(lang)) },
    { '@type': 'ListItem', position: 2, name, item: abs(dialectPath(lang, d.id)) },
  ],
};
---
<Base lang={lang} title={`${t(lang, 'metaDialectTitle', { dialect: name })} | Familect`} description={`${t(lang, 'metaDialectDesc', { n: d.entries.length, dialect: name })}${lang === 'en' ? ' ' : ''}${intro}`}alternates={alternates} jsonLd={[breadcrumb]} feedbackDialect={d.id}>
  <div class="wrap page" data-dialect-page>
    <nav class="breadcrumb"><a href={homePath(lang)}>{t(lang, 'home')}</a> / <span>{name}</span></nav>

    <header class="dialect-head">
      <h1>{name}<span class="dialect-en">{otherName}</span></h1>
      <p class="lead">{intro}</p>
    </header>

    {d.regions.length > 0 && (
      <div class="chips" data-filter-group="region">
        <a class="chip is-active" href="?" data-value="">{t(lang, 'all')}</a>
        {d.regions.map((r) => <a class="chip" href={`?region=${r.id}`} data-value={r.id}>{pick(lang, r.name, r.nameEn)}</a>)}
      </div>
    )}

    <div class="dialect-layout">
      <aside>
        <p class="cat-label">{t(lang, 'categories')}</p>
        <!-- 有词条的分类链接到分类页，方便搜索引擎收录；点击时由下面的脚本就地筛选 -->
        <div class="cat-list" data-filter-group="cat">
          <a class="cat-item is-active" href="?" data-value="">{t(lang, 'allEntries')}</a>
          {d.categories.map((c) => (
            <a class="cat-item" href={withPage.has(c.id) ? categoryPath(lang, d.id, c.id) : `?cat=${c.id}`} data-value={c.id} data-name={pick(lang, c.name, c.nameEn)}>
              <span>{pick(lang, c.name, c.nameEn)}</span>
              {c.caution && <small>{t(lang, 'caution')}</small>}
            </a>
          ))}
        </div>
      </aside>

      <section>
        <div class="list-head">
          <h2 class="list-title" data-list-title data-all={t(lang, 'allEntries')}>{t(lang, 'allEntries')}</h2>
          <button type="button" class="btn-ghost" data-export-start>{t(lang, 'exportStart')}</button>
        </div>
        <ul class="entry-list">
          {d.entries.map((e) => (
            <EntryCard lang={lang} dialect={d} entry={e} badge={isCaution(d, e) ? catName(e.category) : undefined} />
          ))}
        </ul>
        <p class="filter-empty" hidden>{t(lang, 'filterEmpty')}</p>
      </section>
    </div>

    <div class="export-bar" data-export-bar hidden>
      <div class="export-bar-inner">
        <span class="export-count" data-export-count data-template={t(lang, 'exportSelected')}></span>
        <button type="button" class="btn-ghost" data-export-all>{t(lang, 'exportSelectShown')}</button>
        <button type="button" class="btn-ghost" data-export-cancel>{t(lang, 'exportCancel')}</button>
        <a class="btn-primary" href={exportPath(lang, d.id)} data-export-href={exportPath(lang, d.id)} data-export-go aria-disabled="true">{t(lang, 'exportGo')}</a>
      </div>
    </div>
  </div>
</Base>

<script>
  import { parseFilter, matchesFilter, filterQuery, type Filter } from '../lib/filter';

  const root = document.querySelector<HTMLElement>('[data-dialect-page]');
  if (root) {
    const links = (group: 'cat' | 'region') => [...root.querySelectorAll<HTMLAnchorElement>(`[data-filter-group="${group}"] a`)];
    const groups = { cat: links('cat'), region: links('region') };
    const ids = (group: 'cat' | 'region') => groups[group].map((a) => a.dataset.value ?? '').filter(Boolean);
    const cards = [...root.querySelectorAll<HTMLElement>('[data-entry]')];
    const title = root.querySelector<HTMLElement>('[data-list-title]')!;
    const empty = root.querySelector<HTMLElement>('.filter-empty')!;
    let filter: Filter = parseFilter(location.search, ids('cat'), ids('region'));

    const apply = () => {
      for (const group of ['cat', 'region'] as const) {
        for (const a of groups[group]) {
          const on = (a.dataset.value || undefined) === filter[group];
          a.classList.toggle('is-active', on);
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        }
      }
      let shown = 0;
      for (const card of cards) {
        const ok = matchesFilter({ cat: card.dataset.cat ?? '', regions: (card.dataset.regions ?? '').split(' ').filter(Boolean) }, filter);
        card.hidden = !ok;
        if (ok) shown++;
      }
      empty.hidden = shown > 0;
      const activeCat = groups.cat.find((a) => a.dataset.value === filter.cat);
      title.textContent = filter.cat && activeCat ? (activeCat.dataset.name ?? '') : (title.dataset.all ?? '');
    };

    for (const group of ['cat', 'region'] as const) {
      for (const a of groups[group]) {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          filter = { ...filter, [group]: a.dataset.value || undefined };
          history.replaceState(null, '', location.pathname + filterQuery(filter));
          apply();
        });
      }
    }
    apply();
  }
</script>

<script>
  import { parseIds, idsQuery } from '../lib/export';

  // 选词导出：勾选词条后跳到导出页，已选的 id 放在网址里，从导出页返回时会带回来
  const root = document.querySelector<HTMLElement>('[data-dialect-page]');
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-entry]')];
    const boxes = items.map((li) => li.querySelector<HTMLInputElement>('.entry-pick')!);
    const bar = root.querySelector<HTMLElement>('[data-export-bar]')!;
    const count = root.querySelector<HTMLElement>('[data-export-count]')!;
    const go = root.querySelector<HTMLAnchorElement>('[data-export-go]')!;
    const order: string[] = [];

    const update = () => {
      for (const b of boxes) {
        const i = order.indexOf(b.value);
        if (b.checked && i < 0) order.push(b.value);
        if (!b.checked && i >= 0) order.splice(i, 1);
      }
      count.textContent = (count.dataset.template ?? '').replace('{n}', String(order.length));
      go.href = (go.dataset.exportHref ?? '') + idsQuery(order);
      go.setAttribute('aria-disabled', String(order.length === 0));
    };
    const setSelecting = (on: boolean) => {
      root.classList.toggle('is-selecting', on);
      bar.hidden = !on;
      if (!on) boxes.forEach((b) => (b.checked = false));
      update();
    };

    root.querySelector('[data-export-start]')!.addEventListener('click', () => setSelecting(true));
    root.querySelector('[data-export-cancel]')!.addEventListener('click', () => setSelecting(false));
    root.querySelector('[data-export-all]')!.addEventListener('click', () => {
      items.forEach((li, i) => {
        if (!li.hidden) boxes[i].checked = true;
      });
      update();
    });
    for (const b of boxes) b.addEventListener('change', update);
    // 选词时点卡片等于勾选，不跳转
    items.forEach((li, i) => {
      li.querySelector('a')!.addEventListener('click', (e) => {
        if (!root.classList.contains('is-selecting')) return;
        e.preventDefault();
        boxes[i].checked = !boxes[i].checked;
        update();
      });
    });
    go.addEventListener('click', (e) => {
      if (order.length === 0) e.preventDefault();
    });

    const preset = parseIds(location.search, boxes.map((b) => b.value));
    if (preset.length) {
      for (const id of preset) boxes.find((b) => b.value === id)!.checked = true;
      setSelecting(true);
      order.splice(0, order.length, ...preset);
      update();
    }
  }
</script>
